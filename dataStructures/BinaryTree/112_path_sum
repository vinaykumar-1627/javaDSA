/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public  void preOrderTraversal(TreeNode root,int targetSum,int sum){
        if(root==null){
            return ;
        }
        sum+=root.val;
        if(root.left==null && root.right==null){
            if(targetSum == sum) ans = true;
            return ;
        }
        preOrderTraversal(root.left,targetSum,sum);
        preOrderTraversal(root.right,targetSum,sum);
    }
    boolean ans =false;
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root==null) return ans ;
        preOrderTraversal(root,targetSum,0);
        return ans;
    }
}
