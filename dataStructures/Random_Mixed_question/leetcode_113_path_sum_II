/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private List<List<Integer>> list2d;
    private List<Integer> list1d;
    public List<List<Integer>> pathSum(TreeNode root, int target) {
        list2d= new ArrayList<>();
        list1d=new ArrayList<>();
        dfs(root,target,0,list1d);
        return list2d;
    }
    private void dfs(TreeNode root,int target,int sum,List<Integer> list1d){
        if(root==null) return ;
        list1d.add(root.val);
        sum+=root.val;
        if(root.left==null && root.right==null){
            if(sum==target) {
                list2d.add(new ArrayList<>(list1d));
            }
        } 
        dfs(root.left,target,sum,list1d); 
        dfs(root.right,target,sum,list1d);
        list1d.remove(list1d.size()-1);
    }
}
