class Solution {
    public List<Integer> majorityElement(int[] nums) {
        Map<Integer,Integer> map= new HashMap<>();
        List<Integer> list= new ArrayList<>();
        for(int ele:nums)  map.put(ele,map.getOrDefault(ele,0)+1);
        map.forEach((key,val)->{
            if(val>nums.length/3) list.add(key);
        });
        return list;
    }
}
