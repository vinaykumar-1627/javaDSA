class Solution {
    public int countStudents(int[] students, int[] sandwiches) {
        Stack<Integer> st= new Stack<>();
        Queue<Integer> que= new ArrayDeque<>();
        for(int i=sandwiches.length-1;i>=0;i--) st.push(sandwiches[i]) ;
        for(int i=0;i<students.length;i++) que.offer(students[i]) ;
        int eaten=0;
        int count=0;
        while(st.size()!=0){
            if(count==que.size()) break;
            if(st.peek()==que.peek()){
                st.pop();
                que.remove();
                eaten++;// count the no of students who ate the sandwich
                count=0;
            }
            else {
                que.offer(que.remove());
                count++;
            }
        }
        return sandwiches.length-eaten ;
    }
}
