class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        // Code here
        int low=0;
        int high=0;
        int sum=0;
        int max=0;
        while(high<k){
            sum+=arr[high];
            high++;
        }
        max=sum;
        while(high<arr.length){
            sum=sum-arr[low]+arr[high];
            low++; high++;
            if(sum>max) max=sum;
        }
        return max;
    }
}
