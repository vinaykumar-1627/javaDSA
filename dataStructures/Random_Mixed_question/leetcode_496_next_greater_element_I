class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        int idx=0;
        while(idx<nums1.length){
            int max= 10001;
            int idxval=nums1[idx];
            for(int i=0;i<nums2.length;i++){
                if(nums1[idx]==nums2[i]) max=nums2[i]; 
                else{
                    if(nums2[i]>max) {
                        nums1[idx]=nums2[i];
                        break;
                    }
                }
            }
            if(nums1[idx]==idxval) nums1[idx]=-1;
            idx++;
        }
        return nums1;
    }
}
