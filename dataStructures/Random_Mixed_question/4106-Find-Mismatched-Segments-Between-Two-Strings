class Solution {
    public List<List<String>> findMismatchedSegments(String s1, String s2) {
        List<List<String>> list = new ArrayList<>();
        StringBuilder sb1 = new StringBuilder();
        StringBuilder sb2 = new StringBuilder();
        int i = 0;
        while (i < s1.length()) {
            char ch1 = s1.charAt(i);
            char ch2 = s2.charAt(i);
            if (ch1 == ch2) {
                if (!sb1.isEmpty()) {
                    List<String> l = Arrays.asList(sb1.toString(), sb2.toString());
                    list.add(l);
                    sb1.setLength(0);
                    sb2.setLength(0);
                }
            } else {
                sb1.append(ch1);
                sb2.append(ch2);
            }
            i++;
        }
        if (!sb1.isEmpty()) {
            List<String> l = Arrays.asList(sb1.toString(), sb2.toString());
            list.add(l);
            sb1.setLength(0);
            sb2.setLength(0);
        }
        return list;
    }
}
