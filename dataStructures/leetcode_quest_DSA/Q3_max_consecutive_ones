class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int sum=0, low=0, high=0;
        while(high<nums.length){
            int count=0;
            while(high<nums.length &&  nums[high]==1){
                count++; high++;
            }
            sum=Math.max(count,sum);
            low=high;
            while(low<nums.length && nums[low]==0 ){ 
                low++;
            }
            high=low;
        }
        return sum;
    }
}
