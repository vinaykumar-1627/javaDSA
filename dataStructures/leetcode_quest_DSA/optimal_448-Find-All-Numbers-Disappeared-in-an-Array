class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        for(int ele : nums){
            nums[Math.abs(ele)-1]= (-1)*Math.abs(nums[Math.abs(ele)-1]);
        }
        List<Integer> list = new ArrayList<>();
        for(int i=0;i<nums.length;i++){
            if(nums[i]>0) list.add(i+1); 
        }
        return list ;
    }
}
